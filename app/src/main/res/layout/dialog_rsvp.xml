<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/rsvp_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/close"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/rsvp_title" />

    <FrameLayout
        android:id="@+id/rsvp_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="2dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:layout_marginBottom="64dp"
            android:background="@color/rsvp_focus" />

        <TextView
            android:id="@+id/rsvp_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceDisplaySmall" />

        <View
            android:layout_width="2dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:layout_marginTop="64dp"
            android:background="@color/rsvp_focus" />

        <TextView
            android:id="@+id/rsvp_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="@string/rsvp_hint"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/rsvp_toggle"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/tts_resume"
            android:src="@drawable/ic_play" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/rsvp_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <com.google.android.material.slider.Slider
                android:id="@+id/rsvp_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/speed"
                android:stepSize="25"
                android:valueFrom="200"
                android:valueTo="600" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
