<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/compare_toolbar"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/tool_compare" />

    <LinearLayout
        android:id="@+id/panes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/reader_bg_light"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.ninereader.reader.view.ZoomableRecyclerView
                android:id="@+id/pages_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/compare_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pick_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/compare_pick_first" />

            <TextView
                android:id="@+id/label_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_page_indicator"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="?attr/colorOutline" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.ninereader.reader.view.ZoomableRecyclerView
                android:id="@+id/pages_b"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/compare_right" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pick_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/compare_pick_second" />

            <TextView
                android:id="@+id/label_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_page_indicator"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFFFF"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
